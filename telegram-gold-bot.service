[Unit]
Description=Telegram Gold/Currency Price Bot
After=network.target

[Service]
Type=simple
# مسیر پوشه پروژه را اینجا وارد کنید
WorkingDirectory=/root/telegram_gold_bot
# اگر از virtualenv استفاده می‌کنید، مسیر پایتون آن را اینجا بدهید
ExecStart=/usr/bin/python3 /root/telegram_gold_bot/bot.py
Restart=always
RestartSec=10
# می‌توانید به‌جای ویرایش config.py، توکن را اینجا هم ست کنید:
# Environment=BOT_TOKEN=123456:ABC...
# Environment=CHANNEL_ID=@your_channel

[Install]
WantedBy=multi-user.target
